{
  "name": "project-cockpit",
  "version": "1.1.1",
  "description": "A local-first, static project dashboard with evidence-based weighted milestone progress.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "npm run test:unit && npm run test:e2e",
