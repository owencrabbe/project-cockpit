    "test:e2e": "playwright test",
    "build:example": "node scripts/build-example.js",
    "zip": "node scripts/zip.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1"
  }
}
